node_modules/
dist/
out/
.DS_Store
*.log
.env
.env.*
release/
.vite/
coverage/
*.local
*.tsbuildinfo

# Bundled output of on-demand verification scripts (regenerated on demand)
scripts/.verify-mindray.mjs
scripts/.verify-presets.mjs
scripts/.verify-magicl.mjs
scripts/.verify-mapgrade.mjs
scripts/.verify-units.mjs
scripts/.verify-rohtak.mjs

# Ad-hoc dot-prefixed scripts in scripts/ — build artifacts and one-off DB
# queries. These carry live LIS credentials, so they must never be committed.
scripts/.*.mjs

# Per-machine Claude Code tool permissions (the shared skills/ dir IS committed)
.claude/settings.local.json

# Local LIS cleanup backups (contain patient result values — never commit)
*-backup.json

# electron-builder output dirs (installers must not be committed)
installer/
pkg*/
dist-*/
out-pkg/
Thumbs.db

# Analyzer captures kept ON PURPOSE, overriding the blanket *.log above. The eLab
# logs a preset was derived from ARE the evidence for every mapping decision in
# it, and get re-read months later when an analyzer drifts — the Rohtak DxC's
# frame layout changed mid-investigation and only the original capture proved it.
# Keep the folders unzipped so they stay greppable.
!Logs mindray/
!Logs mindray/*.log
!eLabs logs/
!eLabs logs/**/
!eLabs logs/**/*.log
